{
  "mcpServers": {
    "opensocial-youtube": {
      "command": "/ABSOLUTE/PATH/opensocial-mcp/.venv/bin/opensocial-youtube",
      "env": {
        "OPENSOCIAL_ENV_FILE": "/ABSOLUTE/PATH/opensocial-mcp/.env",
        "OPENSOCIAL_API_KEY": "osagent_REPLACE_WITH_YOUR_AGENT_KEY"
      }
