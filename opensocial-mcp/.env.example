# Copy to .env and fill in. NEVER commit .env.
# Generate an encryption key with:  opensocial generate-key
OPENSOCIAL_ENVIRONMENT=development
OPENSOCIAL_ENCRYPTION_KEYS=
OPENSOCIAL_DATABASE_URL=sqlite:///./opensocial.db
OPENSOCIAL_PUBLIC_BASE_URL=http://127.0.0.1:8080
OPENSOCIAL_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:5173
OPENSOCIAL_MEDIA_ROOTS=./media

# Simulated platform APIs (no real accounts touched). Set to false for live use.
OPENSOCIAL_DEMO_MODE=true

# Agent key used by stdio MCP servers (from `opensocial create-user`).
# Prefer setting this in your MCP client config instead of here.
OPENSOCIAL_API_KEY=

# Meta Graph API version used for Facebook, Instagram and WhatsApp.
OPENSOCIAL_META_GRAPH_VERSION=v26.0

# --- Your own developer app credentials (see docs/platform_capabilities.md) ---
OPENSOCIAL_GOOGLE_CLIENT_ID=
OPENSOCIAL_GOOGLE_CLIENT_SECRET=
OPENSOCIAL_TIKTOK_CLIENT_KEY=
OPENSOCIAL_TIKTOK_CLIENT_SECRET=
OPENSOCIAL_META_APP_ID=
OPENSOCIAL_META_APP_SECRET=
OPENSOCIAL_INSTAGRAM_APP_ID=
OPENSOCIAL_INSTAGRAM_APP_SECRET=
OPENSOCIAL_WHATSAPP_APP_SECRET=
OPENSOCIAL_WHATSAPP_VERIFY_TOKEN=

# docker-compose only
POSTGRES_PASSWORD=
